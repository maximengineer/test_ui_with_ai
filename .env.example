# This file is an example. Copy it to .env and fill in your actual secrets.
# Do not commit the .env file to version control.

# OpenRouter API key. Get one at https://openrouter.ai/keys.
# OpenRouter exposes an OpenAI-compatible chat completions endpoint and
# routes to dozens of providers/models behind a single key. The analyzer
# defaults to qwen/qwen3.6-plus (vision-capable, ~$0.085 per 20-site audit
# at current pricing) which has no per-day RPD throttle.
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Model slug (provider/model). Default is qwen/qwen3.6-plus, which has
# confirmed text+image+video input on OpenRouter and a 1M context window.
# Cheaper text-only alternatives (drop the screenshot if you switch to one):
#   minimax/minimax-m2.7    -- $0.299/$1.20 per M tokens, 196K context
#   deepseek/deepseek-v4-pro -- $0.435/$0.87 per M tokens, 1M context
# AFR_AI_MODEL="qwen/qwen3.6-plus"

# Override the OpenAI-compatible base URL. Default targets OpenRouter.
# Set this if you point the analyzer at a different OpenAI-compatible
# provider (Anthropic via proxy, vLLM, LM Studio, etc.).
# AFR_AI_BASE_URL="https://openrouter.ai/api/v1"

# AI analyzer service URL.
# Default for Docker: http://ai-analyzer:3000 (service-name resolution inside docker-compose).
# For local development outside Docker, set this to http://localhost:3000.
# AFR_AI_ANALYZER_SERVICE_URL=http://localhost:3000

# Disable AI calls entirely (Phase A.1.9). When false, the report generator
# writes ai_disabled.json marker files instead of contacting the AI service.
# AFR_AI_ENABLED=true

# Mask obvious secrets in structured HTML/CSS/JS diff strings before sending
# them to the AI analyzer.
# AFR_AI_REDACT_STRUCTURED_DATA=true

# Keep screenshots in local report artifacts but omit screenshot base64 from
# AI requests. Enable if visual page contents must not leave the local machine.
# AFR_AI_REDACT_SCREENSHOTS=false

# Mask obvious secrets in structured_data.json files written under data/report.
# Comparator/crawler source artifacts remain raw.
# AFR_REPORT_REDACT_STRUCTURED_DATA=true

# Concurrency cap for AI requests (Phase A.1.10). Default 3.
# AFR_AI_CONCURRENCY=3

# Block private/link-local/loopback crawl targets by default to reduce SSRF
# risk from dashboard-added URLs. Set true only for intentional internal-site
# tests in a trusted environment.
# AFR_ALLOW_PRIVATE_SITE_URLS=false

# Crawler-time hardening for DNS-resolved private targets and redirect chains.
# These checks run immediately before browser/resource fetches.
# AFR_SITE_URL_CHECK_DNS=true
# AFR_SITE_URL_CHECK_REDIRECTS=true
# AFR_SITE_URL_REDIRECT_LIMIT=5

# Optional Docker egress allowlist. When enabled, the test-ui/dashboard
# entrypoint programs iptables so only allowlisted resolved IPs can receive
# outbound traffic. Exact site hosts from sites.yml are included by default;
# add CDN/API domains or CIDRs here if captures need them.
# Requires rebuilding images after this feature is added (`make dashboard-build`
# for dashboard, `docker compose build test-ui` for CLI image changes) and
# running with the egress override:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.egress.yml
# AFR_EGRESS_ALLOWLIST_ENABLED=false
# AFR_EGRESS_ALLOWLIST="cdn.example.com,api.example.com,203.0.113.0/24"
# AFR_EGRESS_ALLOWLIST_INCLUDE_SITES=true
# AFR_EGRESS_SITES_FILE=/app/test_ui/sites.yml

# NOTE: AI_ANALYZER_SERVICE_URL (unprefixed) was removed in Phase A.0.4.
# If you have it set, the application will warn and ignore it.
# Use AFR_AI_ANALYZER_SERVICE_URL instead.
