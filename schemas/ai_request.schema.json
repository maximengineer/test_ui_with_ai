    "Screenshots": {
      "additionalProperties": false,
      "description": "Base64-encoded screenshot bytes. All optional; at least one expected.\n\nThe Node side enforces image size + magic-byte validation in Phase A.1.4.\nPydantic only validates the strings are valid base64.",
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "current": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "visual_diff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Diff"
        }
      },
      "title": "Screenshots",
      "type": "object"
    },
