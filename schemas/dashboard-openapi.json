              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunRow"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Post Sync",
        "operationId": "post_sync_api_sync_post",
        "responses": {
