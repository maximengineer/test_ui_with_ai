    "/api/reports/{date}/{run_id}/screenshot": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Report Screenshot",
        "description": "Return one PNG (baseline / current / diff) for one URL.\n\nQuery-param typing on `which` is FastAPI-enforced (a different value\nyields 422). `url_id` is validated against the actual on-disk\nchildren, so a bogus value can't traverse OR enumerate.",
        "operationId": "get_report_screenshot_api_reports__date___run_id__screenshot_get",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Date"
            }
          },
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "url_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Url Id"
            }
          },
          {
            "name": "which",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "baseline",
                "current",
                "diff"
              ],
              "type": "string",
              "title": "Which"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "image/png": {}
            }
          },
          "400": {
            "description": "Malformed parameters"
          },
          "404": {
            "description": "No such url_id, or no screenshot of that kind"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "description": "Liveness check. Never raises \u2014 degraded states surface as `False`s.\n\nDoes NOT use `DbDep`: if the DB itself can't be opened (disk full,\npermission denied on the WAL file), the dependency would raise BEFORE\nthe handler runs and FastAPI would 500. We want the failure to\nsurface as `db_ok=False` instead \u2014 that's the entire point of having\na health route.\n\nThe AI analyzer probe is bounded to 2s so a hung analyzer container\ncan't make `/api/health` itself appear hung. The overall `ok` mirrors\n`db_ok` only \u2014 the analyzer being down doesn't invalidate the dashboard\n(it just disables AI-dependent UI affordances client-side).",
        "operationId": "get_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaselineRunRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "baseline",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "BaselineRunRequest"
      },
      "ComparatorRunRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "comparator",
            "title": "Kind"
          },
          "baseline_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Run Id"
          },
          "current_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "ComparatorRunRequest"
      },
      "CurrentRunRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "current",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "CurrentRunRequest"
      },
      "DatesOut": {
        "properties": {
          "baseline": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Baseline"
          },
          "current": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Current"
          },
          "comparator": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Comparator"
          },
          "report": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Report"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DatesOut",
        "description": "Per-kind list of date directories present on disk.\n\nThe frontend uses this to populate date pickers without scanning\nthe filesystem itself. Dates are DD-MM-YYYY strings, sorted descending\n(newest first) so the UI can default to the most recent."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "db_ok": {
            "type": "boolean",
            "title": "Db Ok"
          },
          "ai_analyzer_ok": {
            "type": "boolean",
            "title": "Ai Analyzer Ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ok",
          "db_ok",
          "ai_analyzer_ok"
        ],
        "title": "HealthOut",
