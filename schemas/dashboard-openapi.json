            }
          }
        }
      }
    },
    "/api/runs/{db_id}/retry": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Post Run Retry",
        "description": "Re-spawn a run with the same args as `db_id`.\n\nReads `args_json` off the original row + reconstructs the matching\n`RunRequest` subclass; from there it's the same path as `POST /api/runs`,\nso 409 / 412 still apply (a retry of an already-running comparison\ncorrectly conflicts).",
        "operationId": "post_run_retry_api_runs__db_id__retry_post",
        "parameters": [
          {
            "name": "db_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Db Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSpawnedOut"
                }
              }
            }
          },
          "404": {
            "description": "No such db_id"
          },
          "409": {
            "description": "Conflicting in-flight run"
          },
          "412": {
            "description": "Workflow precondition not met"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{db_id}/logs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Run Logs",
        "description": "Stream the subprocess log file. Always capped at 1 MB even without\n`tail` to prevent runaway responses.\n\nReturns 404 if the row doesn't exist OR if the log file hasn't been\ncreated yet (the spawn opens it lazily \u2014 a row in `pending` for less\nthan a few ms may have no log).",
        "operationId": "get_run_logs_api_runs__db_id__logs_get",
        "parameters": [
          {
            "name": "db_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Db Id"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 1048576,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Return only the last N bytes of the log (max 1048576).",
              "title": "Tail"
            },
            "description": "Return only the last N bytes of the log (max 1048576)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/plain": {}
            }
          },
          "404": {
            "description": "No row, or no log file yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
