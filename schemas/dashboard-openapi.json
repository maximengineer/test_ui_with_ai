{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Frontend Regression Dashboard",
    "description": "Local-first dashboard for managing UI regression runs. See REFACTOR_AND_DASHBOARD_PLAN.md milestone C for scope.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/sites": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Get Sites",
        "description": "Read sites from `test_ui/sites.yml`.",
        "operationId": "get_sites_api_sites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteOut"
                  },
                  "type": "array",
                  "title": "Response Get Sites Api Sites Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "sites"
        ],
        "summary": "Post Sites",
        "description": "Append a new site. The id is auto-generated server-side from the\nslugified name with a `-N` suffix on collision (so id-conflict 409s\nare structurally impossible \u2014 see `add_site`). Atomic write\npreserves operator-authored YAML comments.",
        "operationId": "post_sites_api_sites_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteOut"
                }
              }
            }
          },
          "422": {
            "description": "Body validation failed"
          }
        }
      }
    },
    "/api/sites/{site_id}": {
      "patch": {
        "tags": [
          "sites"
        ],
        "summary": "Patch Site",
        "description": "Mutate name and/or url. id is immutable \u2014 use DELETE + POST to rename.",
        "operationId": "patch_site_api_sites__site_id__patch",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteUpdateIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteOut"
                }
              }
            }
          },
          "404": {
            "description": "No site with this id"
          },
          "422": {
            "description": "Body validation failed"
          }
        }
      },
      "delete": {
        "tags": [
          "sites"
        ],
        "summary": "Delete Site Route",
        "description": "Remove a site from sites.yml. On-disk per-site data dirs are NOT\ntouched \u2014 historical artifacts remain readable; only future runs stop\nincluding this site.",
        "operationId": "delete_site_route_api_sites__site_id__delete",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No site with this id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/dates": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Dates",
        "operationId": "get_dates_api_dates_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatesOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get Runs",
        "description": "List runs, newest first. `total` reflects the filtered set.",
        "operationId": "get_runs_api_runs_get",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by kind",
              "title": "Kind"
            },
            "description": "Filter by kind"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by status",
              "title": "Status"
            },
            "description": "Filter by status"
          },
          {
            "name": "date_dir",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to runs whose date_dir matches (DD-MM-YYYY). Lets the Reports page list runs for a single date without client-side truncation.",
              "title": "Date Dir"
            },
            "description": "Filter to runs whose date_dir matches (DD-MM-YYYY). Lets the Reports page list runs for a single date without client-side truncation."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Post Runs",
        "description": "Spawn a new run as a subprocess. Returns 202 with the assigned ids.",
        "operationId": "post_runs_api_runs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/BaselineRunRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CurrentRunRequest"
                  },
                  {
                    "$ref": "#/components/schemas/ComparatorRunRequest"
                  },
                  {
                    "$ref": "#/components/schemas/ReportRunRequest"
                  }
                ],
                "discriminator": {
                  "propertyName": "kind",
                  "mapping": {
                    "baseline": "#/components/schemas/BaselineRunRequest",
                    "current": "#/components/schemas/CurrentRunRequest",
                    "comparator": "#/components/schemas/ComparatorRunRequest",
                    "report": "#/components/schemas/ReportRunRequest"
                  }
                },
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSpawnedOut"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting in-flight run for the same kind+date"
          },
          "412": {
            "description": "Workflow precondition not met (upstream not complete)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{db_id}": {
      "get": {
        "tags": [
